generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model ProductOrder {
  id                  String          @id @default(cuid())
  lemonSqueezyOrderId String          @unique
  customerEmail       String
  customerName        String?
  licenseType         String        
  amountCents         Int
  status              String          @default("PENDING") 
  githubRepo          String?         
  githubInviteSent    Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  license             ProductLicense?

  @@index([customerEmail])
  @@index([status])
  @@index([licenseType])
}

model ProductLicense {
  id              String    @id @default(cuid())
  licenseKey      String    @unique
  customerEmail   String
  licenseType     String    
  orderId         String    @unique
  lemonSqueezyId  String?   // LS license key ID
  activationCount Int       @default(0)
  maxActivations  Int       @default(3)
  status          String    @default("ACTIVE") 
  issuedAt        DateTime  @default(now())
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  order           ProductOrder @relation(fields: [orderId], references: [id])

  @@index([licenseKey])
  @@index([customerEmail])
  @@index([status])
}
